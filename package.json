{
  "name": "blog2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fixture": "CONTENT_DIR=.content-fixture next dev",
    "build": "next build",
    "build:fixture": "CONTENT_DIR=.content-fixture SITE_URL=http://localhost:3000 next build",
    "build:checked": "npm run lint && npm run sync:fixture && npm run build:fixture && npm run test:privacy && npm run build",
    "lint": "eslint",
    "sync": "node --env-file-if-exists=.env.local scripts/sync.ts",
    "sync:fixture": "node scripts/sync.ts --vault scripts/fixtures/vault --out .content-fixture",
    "test:privacy": "node scripts/test-privacy.ts",
    "new:cs": "node scripts/new-cs.ts",
    "icons": "node scripts/favicons.ts"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.4",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.1.0",
    "next": "^16.3.8",
    "parse5": "^7.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.3",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
